n+        }\n+        return true;\n+    }\n+\n     public Entry(){}\n \n     public Entry(OTPType type, String secret, int period, int digits, String issuer, String label, TokenCalculator.HashAlgorithm algorithm, List<String> tags) {\n         this.type = type;\n-        this.secret = new Base32().decode(secret.toUpperCase());\n+        try {\n+            this.secret = new Base32().decode(secret.toUpperCase());\n+        } catch (IllegalArgumentException e) {\n+            throw new IllegalArgumentException(\"Invalid secret: the secret must be a valid base32 string.\", e);\n+        }\n         this.period = period;\n         this.digits = digits;\n         this.issuer = issuer;\n@@ -99,7 +120,11 @@\n \n     public Entry(OTPType type, String secret, long counter, int digits, String issuer, String label, TokenCalculator.HashAlgorithm algorithm, List<String> tags) {\n         this.type = type;\n-        this.secret = new Base32().decode(secret.toUpperCase());\n+        try {\n+            this.secret = new Base32().decode(secret.toUpperCase());\n+        } catch (IllegalArgumentException e) {\n+            throw new IllegalArgumentException(\"Invalid secret: the secret must be a valid base32 string.\", e);\n+        }\n         this.counter = counter;\n         this.digits = digits;\n         this.issuer = issuer;\n\n--- a/app/src/main/java/org/shadowice/flocke/andotp/Dialogs/ManualEntryDialog.java\n+++ b/app/src/main/java/org/shadowice/flocke/andotp/Dialogs/ManualEntryDialog.java\n@@ -48,6 +48,8 @@\n import org.shadowice.flocke.andotp.View.EntriesCardAdapter;\n import org.shadowice.flocke.andotp.View.TagsAdapter;\n \n+import android.widget.Toast;\n+\n import java.util.HashMap;\n import java.util.List;\n import java.util.Locale;\n@@ -195,31 +197,35 @@\n                 .setPositiveButton(R.string.button_save, new DialogInterface.OnClickListener() {\n                     @Override\n                     public void onClick(DialogInterface dialogInterface, int i) {\n-                        Entry.OTPType type = (Entry.OTPType) typeInput.getSelectedItem();\n-                        TokenCalculator.HashAlgorithm algorithm = (TokenCalculator.HashAlgorithm) algorithmInput.getSelectedItem();\n-\n-                        String issuer = issuerInput.getText().toString();\n-                        String label = labelInput.getText().toString();\n-                        //Replace spaces with empty characters\n-                        String secret = secretInput.getText().toString().replaceAll(\"\\\\s+\",\"\");\n-                        int digits = Integer.parseInt(digitsInput.getText().toString());\n-\n-                        if (type == Entry.OTPType.TOTP || type == Entry.OTPType.STEAM) {\n-                            int period = Integer.parseInt(periodInput.getText().toString());\n-\n-                            Entry e = new Entry(type, secret, period, digits, issuer, label, algorithm, tagsAdapter.getActiveTags());\n-                            e.updateOTP();\n-                            e.setLastUsed(System.currentTimeMillis());\n-                            adapter.addEntry(e);\n-\n-                            callingActivity.refreshTags();\n-                        } else if (type == Entry.OTPType.HOTP) {\n-                            long counter = Long.parseLong(counterInput.getText().toString());\n-\n-                            Entry e = new Entry(type, secret, counter, digits, issuer, label, algorithm, tagsAdapter.getActiveTags());\n-                            e.updateOTP();\n-                            e.setLastUsed(System.currentTimeMillis());\n-                            adapter.addEntry(e);\n+                        try {\n+                            Entry.OTPType type = (Entry.OTPType) typeInput.getSelectedItem();\n+                            TokenCalculator.HashAlgorithm algorithm = (TokenCalculator.HashAlgorithm) algorithmInput.getSelectedItem();\n+\n+                            String issuer = issuerInput.getText().toString();\n+                            String label = labelInput.getText().toString();\n+                            //Replace spaces with empty characters\n+                            String secret = secretInput.getText().toString().replaceAll(\"\\\\s+\",\"\");\n+                            int digits = Integer.parseInt(digitsInput.getText().toString());\n+\n+                            if (type == Entry.OTPType.TOTP || type == Entry.OTPType.STEAM) {\n+                                int period = Integer.parseInt(periodInput.getText().toString());\n+\n+                                Entry e = new Entry(type, secret, period, digits, issuer, label, algorithm, tagsAdapter.getActiveTags());\n+                                e.updateOTP();\n+                                e.setLastUsed(System.currentTimeMillis());\n+                                adapter.addEntry(e);\n+\n+                                callingActivity.refreshTags();\n+                            } else if (type == Entry.OTPType.HOTP) {\n+                                long counter = Long.parseLong(counterInput.getText().toString());\n+\n+                                Entry e = new Entry(type, secret, counter, digits, issuer, label, algorithm, tagsAdapter.getActiveTags());\n+                                e.updateOTP();\n+                                e.setLastUsed(System.currentTimeMillis());\n+                                adapter.addEntry(e);\n+                            }\n+                        } catch (IllegalArgumentException e) {\n+                            Toast.makeText(callingActivity, R.string.toast_invalid_secret, Toast.LENGTH_LONG).show();\n                         }\n                     }\n                 })\n\n--- a/app/src/main/res/values/strings_main.xml\n+++ b/app/src/main/res/values/strings_main.xml\n@@ -65,6 +65,7 @@\n     <string name=\"toast_copied_to_clipboard\">Copied to clipboard</string>\n     <string name=\"toast_entry_exists\">This entry already exists</string>\n     <string name=\"toast_invalid_qr_code\">Invalid QR Code</string>\n+    <string name=\"toast_invalid_secret\">Invalid secret: the secret must be a valid base32 string.</string>\n     <string name=\"toast_encryption_key_empty\">Encryption key not loaded</string>\n     <string name=\"toast_intent_creation_failed\">Invalid intent-provided code</string>\n     <string name=\"toast_intent_creation_succeeded\">Intent-provided code added</string>\n```\n\n---\n\n## Verification\n\n- ✅ Project compiles successfully (`BUILD SUCCESSFUL`)\n- ✅ Fix is minimal — only catches the specific exception in the crash path\n- ✅ Existing functionality preserved — valid secrets still work identically\n- ✅ User-facing improvement — shows a clear error message instead of crashing"}],"stop_reason":null,"usage":{"input_tokens":61539,"output_tokens":1899,"cache_read_input_tokens":61248,"total_tokens":63438}}}
