ack {\n   123\n   124          private Participant selectedParticipant;\n   125\n   126          @Override\n   127          public boolean onCreateActionMode(ActionMode mode, Menu menu) {\n   128              MenuInflater inflater = mode.getMenuInflater();\n   129              inflater.inflate(R.menu.options_participant, menu);\n   130\n   131              menu.setGroupEnabled(R.id.menu_group_participant_active_required, selectedParticipant.isActive());\n   132              menu.setGroupEnabled(R.id.menu_group_participant_deletable_required,\n   133                      getApp().getTripController().isParticipantDeletable(selectedParticipant));\n   134              menu.setGroupEnabled(R.id.menu_group_participant_at_least_another, getApp().getTripController().getAllParticipants(false).size() > 1);\n   135\n   136              if (selectedParticipant.isActive()) {\n   137                  menu.removeItem(R.id.option_participant_activate_for_costs);\n   138              } else {\n   139                  menu.removeItem(R.id.option_participant_deactivate_for_costs);\n   140              }\n   141              return true;\n   142          }\n   143\n   144\n   145          @Override\n   146          public boolean onPrepareActionMode(ActionMode mode, Menu menu) {\n   147              return false;\n   148          }\n   149\n   150          @Override\n   151          public boolean onActionItemClicked(ActionMode mode, MenuItem item) {\n   152              switch (item.getItemId()) {\n   153                  case R.id.option_participant_create_payment:\n   154                      getApp().getViewController().openCreatePayment(selectedParticipant);\n   155                      mode.finish();\n   156                      return true;\n   157                  case R.id.option_participant_create_money_transfer:\n   158                      getApp().getViewController().openTransferMoney(selectedParticipant);\n   159                      mode.finish();\n   160                      return true;\n   161                  case R.id.option_participant_show_report:\n   162                      getApp().getTripController().getDialogState().setParticipantReporting(selectedParticipant);\n   163                      ViewPager pager = (ViewPager) getActivity().findViewById(R.id.drawer_content_pager);\n   164                      pager.setCurrentItem(Rc.TAB_ID_REPORT);\n   165                      mode.finish();\n   166                      return true;\n   167                  case R.id.option_participant_deactivate_for_costs:\n   168                      boolean isActive = false;\n   169                      setActiveAndPersist(selectedParticipant, isActive);\n   170                      adapter.notifyDataSetChanged();\n   171                      mode.finish();\n   172                      return true;\n   173                  case R.id.option_participant_activate_for_costs:\n   174                      isActive = true;\n   175                      setActiveAndPersist(selectedParticipant, isActive);\n   176                      adapter.notifyDataSetChanged();\n   177                      mode.finish();\n   178                      return true;\n   179                  case R.id.option_participant_edit:\n   180                      getApp().getViewController().openEditParticipant(selectedParticipant);\n   181                      mode.finish();\n   182                      return true;\n   183                  case R.id.option_participant_delete:\n   184                      if (!getApp().getTripController().deleteParticipant(selectedParticipant)) {\n   185                          Toast.makeText(getActivity(),\n   186                                  getResources().getString(R.string.msg_delete_not_possible_inbalance),\n   187                                  Toast.LENGTH_SHORT)\n   188                                  .show();\n   189                      } else {\n   190                          mode.finish();\n   191                          