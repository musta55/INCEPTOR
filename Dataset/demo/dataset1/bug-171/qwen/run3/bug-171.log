kableSpan[] clickableSpans = editable.getSpans(0, textLength, ClickableSpan.class);\n+        for (ClickableSpan span : clickableSpans) {\n+            int spanEnd = editable.getSpanEnd(span);\n+            if (spanEnd > lastVisibleOffset) {\n+                editable.removeSpan(span);\n+                int newSpanEnd = Math.min(spanEnd, lastVisibleOffset);\n+                editable.setSpan(span, editable.getSpanStart(span), newSpanEnd, editable.getSpanFlags(span));\n+                needsEllipsis = true;\n+            }\n+        }\n+        if (needsEllipsis) {\n+            int hiddenCount = textLength - lastVisibleOffset;\n+            if (hiddenCount > 0) {\n+                editable.delete(lastVisibleOffset, textLength);\n+            }\n+            editable.insert(lastVisibleOffset, \"\\u2026\");\n+        }\n+    }\n+\n+    @Override\n+    protected void onLayout(boolean changed, int left, int top, right, int bottom) {\n+        super.onLayout(changed, left, top, right, bottom);\n+        trimTrailingClickableSpans();\n+    }\n+\n     private void replaceQuoteSpans(Spanned spanned) {\n```\n\n## Explanation\n\n**Problem:** The \"Select text\" dialog in `DialogUtils.showTextSelectionDialog()` uses `HtmlTextView` with `android:textIsSelectable=\"true\"`. When long links are rendered, Android visually truncates them with \"...\" but the underlying `URLSpan` boundaries (which extend `ClickableSpan`) still cover the full hidden text. This means when a user selects text in the dialog, the selection includes content that isn't actually visible.\n\n**Solution:** Override `onLayout()` in `HtmlTextView` to run `trimTrailingClickableSpans()` after layout is computed. This method:\n\n1. Uses `Layout.getOffsetForHorizontal()` to find the offset of the last visible character\n2. Finds all `ClickableSpan` instances (including `URLSpan` for links) that extend past the visible boundary\n3. Trims those spans to end at the visible boundary\n4. Removes the hidden characters and inserts a Unicode ellipsis (`\\u2026`) at the truncation point\n\nThis ensures text selection only includes what's actually visible, matching the visual rendering."}],"stop_reason":null,"usage":{"input_tokens":74698,"output_tokens":957,"cache_read_input_tokens":73360,"total_tokens":75655}}}
