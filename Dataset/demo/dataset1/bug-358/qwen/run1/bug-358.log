.get(newI));\n                }\n                addPart(\"/\", pathSegment, paths, builder);\n            }\n        }\n\n        // query parameters\n        if (parameters.size() > 0) {\n            var queries = addGroup(\"Parameters\", parameters.size(), uri.buildUpon().query(null));\n            for (var i = 0; i < parameters.size(); i++) {\n                // generate same url but without this parameter\n                var builder = uri.buildUpon();\n                builder.query(null);\n                for (var j = 0; j < parameters.size(); j++) {\n                    if (i != j) builder.appendQueryParameter(parameters.get(j).mParameter, parameters.get(j).mValue);\n                }\n                // append the parameter\n                addPart(parameters.get(i).mParameter, parameters.get(i).mValue, queries, builder);\n            }\n        }\n\n        // fragment\n        if (uri.getFragment() != null) {\n            var fragment = addGroup(\"Fragment\", -1, uri.buildUpon().fragment(null));\n            addPart(\"#\", uri.getFragment(), fragment, null);\n        }\n\n        setVisibility(box.getChildCount() > 0);\n    }\n\n    /**\n     * Query parameter holder to avoid dependency on UrlQuerySanitizer internals\n     */\n    private static class QueryParam {\n        String mParameter;\n        String mValue;\n\n        QueryParam(String parameter, String value) {\n            this.mParameter = parameter;\n            this.mValue = value;\n        }\n    }\n\n    /**\n     * Parse query string into parameters, properly handling double-encoded %25 sequences.\n     * UrlQuerySanitizer only does single-pass URL decoding which corrupts double-encoded\n     * parameters like %25E6%259D%25A5 (where %25 represents a literal %).\n     */\n    private static List<QueryParam> parseQueryParams(String query) {\n        List<QueryParam> params = new ArrayList<>();\n        String[] pairs = query.split(\"&\");\n        for (String pair : pairs) {\n            if (pair.isEmpty()) continue;\n            int eqIdx = pair.indexOf('=');\n            String key;\n            String value;\n            if (eqIdx == -1) {\n                key = decodeQueryParam(pair, true);\n                value = \"\";\n            } else {\n                key = decodeQueryParam(pair.substring(0, eqIdx), true);\n                value = decodeQueryParam(pair.substring(eqIdx + 1), false);\n            }\n            params.add(new QueryParam(key, value));\n        }\n        return params;\n    }\n\n    /**\n     * Decode a query parameter part (name or value), properly handling double-encoded %25.\n     *\n     * %25 is the URL-encoded form of the literal % character. When a URL contains %25 followed\n     * by percent-encoded bytes (e.g., %25E6%259D%25A5), it means the original string had\n     * percent-encoded UTF-8 bytes. We need to decode twice to get the actual character:\n     *   %25E6%259D%25A5 -> %E6%9D%A5 (first decode) -> 来 (second decode)\n     */\n    private static String decodeQueryParam(String input, boolean isName) {\n        try {\n            // First pass: decode %25 -> %, and all other %XX -> character\n            String first = URLDecoder.decode(input, StandardCharsets.UTF_8.name());\n            // Second pass: decode any remaining %XX sequences (including the % from %25 -> %)\n            String second = URLDecoder.decode(first, StandardCharsets.UTF_8.name());\n            return second;\n        } catch (UnsupportedEncodingException e) {\n            // Should never happen for UTF-8, but fall back to returning as-is\n            return input;\n        }\n    }","old_string":"    @Override\n    public void onDisplayUrl(UrlData urlData) {\n        // clear\n        box.removeAllViews();\n\n        // parse\n        var uri = Uri.parse(urlData.url);\n        var urlQuerySanitizer = new UrlQuerySanitizer();\n        // the default parseUrl doesn't remove the fragment\n        if (uri.getQuery() != null) {\n            urlQue