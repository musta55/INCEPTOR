ransitionAnimation.LEFT);\n        } catch (Exception e) {\n            Timber.w(e, \"Error Opening Note Editor for multi-select\");\n            UIUtils.showThemedToast(this, getString(R.string.card_browser_note_editor_error), false);\n        }\n    }","old_string":"    /** Opens the note editor for the currently selected note(s) in multi-select mode.\n     * Passes all selected note IDs so that note type changes can affect all of them. */\n    private void openNoteEditorForCurrentlySelectedNote() {\n        try {\n            long[] selectedCardIds = getSelectedCardIds();\n            if (selectedCardIds.length == 0) {\n                return;\n            }\n            // Collect unique note IDs from all selected cards\n            HashSet<Long> noteIds = new HashSet<>();\n            for (long cardId : selectedCardIds) {\n                Card card = getCol().getCard(cardId);\n                noteIds.add(card.noteId());\n            }\n            long[] selectedNoteIds = new long[noteIds.size()];\n            int i = 0;\n            for (long nid : noteIds) {\n                selectedNoteIds[i++] = nid;\n            }\n            // Open editor for the first card (for preview), but pass all note IDs\n            mCurrentCardId = selectedCardIds[0];\n            sCardBrowserCard = getCol().getCard(mCurrentCardId);\n            Intent editCard = new Intent(this, NoteEditor.class);\n            editCard.putExtra(NoteEditor.EXTRA_CALLER, NoteEditor.CALLER_CARDBROWSER_EDIT);\n            editCard.putExtra(NoteEditor.EXTRA_CARD_ID, sCardBrowserCard.getId());\n            editCard.putExtra(NoteEditor.EXTRA_NOTE_IDS, selectedNoteIds);\n            startActivityForResultWithAnimation(editCard, EDIT_CARD, ActivityTransitionAnimation.LEFT);\n        } catch (Exception e) {\n            Timber.w(e, \"Error Opening Note Editor for multi-select\");\n            UIUtils.showThemedToast(this, getString(R.string.card_browser_note_editor_error), false);\n        }\n    }","rep