{"type":"user","uuid":"07935786-8dde-4e79-973a-b0197857ef31","session_id":"572d68c5-ec5a-4a5a-b3b8-523e2c78c78e","parent_tool_use_id":null,"message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"chatcmpl-tool-ad3ce52691a6bb3c","is_error":false,"content":"package com.german_software_engineers.trainerapp;\n\n\nimport android.app.AlertDialog;\nimport android.app.Dialog;\nimport android.content.DialogInterface;\nimport android.os.Bundle;\nimport android.support.v4.app.DialogFragment;\nimport android.text.TextUtils;\nimport android.widget.CheckBox;\nimport android.widget.TextView;\n\nimport com.german_software_engineers.trainerapp.Model.Exercise;\nimport com.german_software_engineers.trainerapp.Model.Schedule;\n\npublic class ExerciseDialog extends DialogFragment {\n    Dialog dialog;\n    Schedule Schedule = null;\n\n    @Override\n    public Dialog onCreateDialog(Bundle savedInstanceState) {\n        AlertDialog.Builder builder = new AlertDialog.Builder(getActivity());\n\n        builder.setView(R.layout.exersice_dialog)\n                .setPositiveButton(R.string.ok, new DialogInterface.OnClickListener() {\n                    public void onClick(DialogInterface dialog, int id) {\n                        generateExcercise();\n                    }\n                })\n                .setNegativeButton(R.string.cancel, new DialogInterface.OnClickListener() {\n                    public void onClick(DialogInterface dialog, int id) {\n                        dialog.cancel();\n                    }\n                });\n        dialog = builder.create();\n        return dialog;\n    }\n\n    private int parseIntOrZero(TextView textView) {\n        String text = textView.getText().toString().trim();\n        if (TextUtils.isEmpty(text)) {\n            return 0;\n        }\n        try {\n            return Integer.parseInt(text);\n        } catch (NumberFormatException e) {\n            return 0;\n        }\n    }\n\n    private double parseDoubleOrZero(TextView textView) {\n        String text = textView.getText().toString().trim();\n        if (TextUtils.isEmpty(text)) {\n            return 0.0;\n        }\n        try {\n            return Double.parseDouble(text);\n        } catch (NumberFormatException e) {\n            return 0.0;\n        }\n    }\n\n    public void generateExcercise(){\n        String name = ((TextView)dialog.findViewById(R.id.exerciseName)).getText().toString();\n\n        boolean isSeatActivated = ((CheckBox)dialog.findViewById(R.id.seatCheckBox)).isChecked();\n        Integer seatPos = 0;\n        if(isSeatActivated)\n            seatPos = parseIntOrZero((TextView)dialog.findViewById(R.id.SeatEdit));\n\n        boolean isLegActivated = ((CheckBox)dialog.findViewById(R.id.LegCheckBox)).isChecked();\n        Integer LegPos = 0;\n        if(isLegActivated)\n            LegPos = parseIntOrZero((TextView)dialog.findViewById(R.id.LegEdit));\n\n        boolean isFootActivated = ((CheckBox)dialog.findViewById(R.id.FootCheckBox)).isChecked();\n        Integer footPos = 0;\n        if(isFootActivated)\n            footPos = parseIntOrZero((TextView)dialog.findViewById(R.id.FootEdit));\n\n        boolean isAngleActivated = ((CheckBox)dialog.findViewById(R.id.AngleCheckBox)).isChecked();\n        Integer anglePos = 0;\n        if(isAngleActivated)\n            anglePos = parseIntOrZero((TextView)dialog.findViewById(R.id.AngleEdit));\n\n        boolean isBackActivated = ((CheckBox)dialog.findViewById(R.id.BackCheckBox)).isChecked();\n        Integer backPos = 0;\n        if(isBackActivated)\n            backPos = parseIntOrZero((TextView)dialog.findViewById(R.id.BackEdit));\n\n        boolean isWeightActivated = ((CheckBox)dialog.findViewById(R.id.WeightCheckBox)).isChecked();\n        Double weight = 0.0;\n        if(isWeightActivated)\n            weight = parseDoubleOrZero((TextView)dialog.findViewById(R.id.WeightEdit));\n\n        Exercise exc = new Exercise(name,isSeatActivated, isLegActivated,isFootActivated,isAngleActivated,isWeightActivated, isBackActivated);\n        exc.setAnglePosition(anglePos.intValue());\n        exc.setFootPosition(footPos.intValue());\n        exc.setLegPosition(LegPos.intValue());\n        exc.setSeatPosition(seatPos.intValue());\n        exc.setWeight(weight.doubleValue());\n        exc.setBackPosition(backPos.intValue());\n\n        Schedule.addExercise(exc);\n    }\n\n    public void setSchedule(Schedule schedule){\n        Schedule = schedule;\n    }\n}\n"}]}}
